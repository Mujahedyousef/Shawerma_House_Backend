generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  username  String?  @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model HeroSection {
  id               String      @id @default(uuid())
  isActive         Boolean     @default(true)
  titleEn          String
  titleAr          String
  descriptionEn    String
  descriptionAr    String
  buttonTextEn     String
  buttonTextAr     String
  buttonLink       String?
  autoPlayInterval Int         @default(5000)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  mediaItems       HeroMedia[]
  stats            HeroStat[]

  @@map("hero_sections")
}

model HeroMedia {
  id            String      @id @default(uuid())
  heroSectionId String
  type          String
  url           String
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  heroSection   HeroSection @relation(fields: [heroSectionId], references: [id], onDelete: Cascade)

  @@map("hero_media")
}

model HeroStat {
  id            String      @id @default(uuid())
  heroSectionId String
  numberEn      String
  numberAr      String
  labelEn       String
  labelAr       String
  descriptionEn String
  descriptionAr String
  link          String?
  buttonTextEn  String?
  buttonTextAr  String?
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  heroSection   HeroSection @relation(fields: [heroSectionId], references: [id], onDelete: Cascade)

  @@map("hero_stats")
}

model CategoriesSectionSettings {
  id                String   @id @default(uuid())
  sectionTitleEn    String   @default("Product Categories")
  sectionTitleAr    String   @default("فئات المنتجات")
  sectionSubtitleEn String?  @default("Explore More")
  sectionSubtitleAr String?  @default("استكشف المزيد")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("categories_section_settings")
}

model Category {
  id           String    @id @default(uuid())
  titleEn      String
  titleAr      String
  productCount Int
  imageUrl     String
  gridClasses  String
  order        Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@map("categories")
}

model SolutionsSectionSettings {
  id                String   @id @default(uuid())
  sectionTitleEn    String   @default("Solutions that fit your needs")
  sectionTitleAr    String   @default("حلول تناسب احتياجاتك")
  sectionSubtitleEn String?
  sectionSubtitleAr String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("solutions_section_settings")
}

model Solution {
  id              String   @id @default(uuid())
  titleEn         String
  titleAr         String
  descriptionEn   String?
  descriptionAr   String?
  imageUrl        String
  height          String
  tags            Json?
  extraCount      Int?
  ctaButtonTextEn String?
  ctaButtonTextAr String?
  ctaButtonLink   String?
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("solutions")
}

model ProjectsSectionSettings {
  id                String    @id @default(uuid())
  sectionTitleEn    String    @default("Our proud projects")
  sectionTitleAr    String    @default("مشاريعنا الفخورة")
  sectionSubtitleEn String?
  sectionSubtitleAr String?
  buttonTextEn      String    @default("View project details")
  buttonTextAr      String    @default("عرض تفاصيل المشروع")
  ctaButtonTextEn   String    @default("View more projects")
  ctaButtonTextAr   String    @default("عرض المزيد من المشاريع")
  ctaButtonLink     String?
  galleryTitleEn    String    @default("Project Photo Gallery")
  galleryTitleAr    String    @default("معرض صور المشروع")
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  projects          Project[]

  @@map("projects_section_settings")
}

model Project {
  id                String                   @id @default(uuid())
  projectsSectionId String?
  titleEn           String
  titleAr           String
  descriptionEn     String?
  descriptionAr     String?
  contentEn         String?
  contentAr         String?
  specifications    Json?
  imageUrl          String
  heroImageUrl      String?
  productsCount     Int
  buttonTextEn      String?                  @default("View project details")
  buttonTextAr      String?                  @default("عرض تفاصيل المشروع")
  buttonLink        String?
  order             Int                      @default(0)
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  galleryImages     ProjectImage[]
  logos             ProjectLogo[]
  projectsSection   ProjectsSectionSettings? @relation(fields: [projectsSectionId], references: [id])

  @@map("projects")
}

model ProjectLogo {
  id        String   @id @default(uuid())
  projectId String
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_logos")
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_images")
}

model ArticlesSectionSettings {
  id                String   @id @default(uuid())
  sectionTitleEn    String   @default("Learn to make better decisions")
  sectionTitleAr    String   @default("تعلم اتخاذ قرارات أفضل")
  sectionSubtitleEn String?
  sectionSubtitleAr String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("articles_section_settings")
}

model Article {
  id        String   @id @default(uuid())
  titleEn   String
  titleAr   String
  imageUrl  String
  date      DateTime
  link      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}

model BrandsSectionSettings {
  id                String      @id @default(uuid())
  sectionTitleEn    String      @default("The best global brands")
  sectionTitleAr    String      @default("أفضل العلامات التجارية العالمية")
  sectionSubtitleEn String?
  sectionSubtitleAr String?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  logos             BrandLogo[]

  @@map("brands_section_settings")
}

model BrandLogo {
  id              String                @id @default(uuid())
  brandsSectionId String
  nameEn          String
  nameAr          String
  imageUrl        String
  order           Int                   @default(0)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  brandsSection   BrandsSectionSettings @relation(fields: [brandsSectionId], references: [id], onDelete: Cascade)
  products        Product[]

  @@map("brand_logos")
}

model DownloadAppSection {
  id                        String   @id @default(uuid())
  titleEn                   String   @default("Download Shawarma House App Now!")
  titleAr                   String   @default("حمّل تطبيق بيت الشاورما الآن!")
  descriptionEn             String   @default("Try your favorite food easier with Shawarma House app! Order, track, and enjoy exclusive offers from the nearest branch, all in simple steps from your phone.")
  descriptionAr             String   @default("جرّب طعامك المفضل بطريقة أسهل مع تطبيق بيت الشاورما! اطلب، تابع، واستمتع بعروض حصرية من أقرب فرع لك، وكل هذا بخطوات بسيطة من جوالك.")
  backgroundImageUrl        String?
  // Light Mode Colors
  backgroundColorLight      String   @default("#ffffff")
  titleColorLight           String   @default("#1a1a1a")
  descriptionColorLight     String   @default("#666666")
  // Dark Mode Colors
  backgroundColorDark       String   @default("#1a1a1a")
  titleColorDark            String   @default("#ffffff")
  descriptionColorDark      String   @default("#cccccc")
  // Images and Links
  appStoreImageUrl          String?
  appStoreLink              String?
  googlePlayImageUrl        String?
  googlePlayLink            String?
  mobileAppImageUrl         String?
  // Animation Settings
  enableInitialAnimation    Boolean  @default(true)
  enableScrollAnimation     Boolean  @default(true)
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("download_app_sections")
}

model Testimonial {
  id                String               @id @default(uuid())
  sectionTitleEn    String               @default("Customer trust comes first")
  sectionTitleAr    String               @default("ثقة العملاء أولاً")
  sectionSubtitleEn String?
  sectionSubtitleAr String?
  textEn            String
  textAr            String
  imageUrl          String
  order             Int                  @default(0)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  profiles          TestimonialProfile[]

  @@map("testimonials")
}

model TestimonialProfile {
  id                  String      @id @default(uuid())
  testimonialId       String
  name                String
  role                String
  imageUrl            String
  testimonialTextEn   String?
  testimonialTextAr   String?
  testimonialImageUrl String?
  order               Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  testimonial         Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@map("testimonial_profiles")
}

model SectionOrder {
  id          String   @id @default(uuid())
  sectionName String   @unique
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("section_orders")
}

model StartProjectSection {
  id                 String   @id @default(uuid())
  titleEn            String   @default("Start your project with us")
  titleAr            String   @default("ابدأ مشروعك معنا")
  descriptionEn      String
  descriptionAr      String
  backgroundImageUrl String
  button1TextEn      String   @default("Talk to an expert")
  button1TextAr      String   @default("تحدث مع خبير")
  button1Link        String?
  button2TextEn      String   @default("Start your order now")
  button2TextAr      String   @default("ابدأ طلبك الآن")
  button2Link        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("start_project_sections")
}

model ThemeSettings {
  id                                String   @id @default(uuid())
  colorBrand                        String   @default("#3daae1")
  colorBrandDark                    String   @default("#1c90ce")
  colorAccent                       String   @default("#22c55e")
  colorDestructive                  String   @default("#ef4444")
  colorWarning                      String   @default("#f59e0b")
  colorInfo                         String   @default("#3b82f6")
  colorRing                         String   @default("#3daae1")
  colorBg1                          String   @default("#f1f5f9")
  colorBg2                          String   @default("#ffffff")
  colorCard                         String   @default("#ffffff")
  colorBorder                       String   @default("#e5e7eb")
  colorText                         String   @default("#020617")
  colorText2                        String   @default("#64748b")
  colorTextMuted                    String   @default("#64748b")
  colorTextMuted2                   String   @default("#94a3b8")
  colorBg1Dark                      String   @default("#020617")
  colorBg2Dark                      String   @default("#0f172a")
  colorCardDark                     String   @default("#1e293b")
  colorBorderDark                   String   @default("#334155")
  colorTextDark                     String   @default("#ffffff")
  colorText2Dark                    String   @default("#cbd5e1")
  colorTextMutedDark                String   @default("#cbd5e1")
  colorTextMuted2Dark               String   @default("#94a3b8")
  colorSectionLight                 String   @default("#F8F9FB")
  colorSectionDark                  String   @default("#0b1320")
  colorTextOnLight                  String   @default("#0b1320")
  colorTextOnDark                   String   @default("#ffffff")
  colorSectionMuted                 String   @default("#f8fafc")
  colorSectionLightDark             String   @default("#0f172a")
  colorSectionDarkDark              String   @default("#f1f5f9")
  colorTextOnLightDark              String   @default("#ffffff")
  colorTextOnDarkDark               String   @default("#0b1320")
  colorSectionMutedDark             String   @default("#1e293b")
  colorButtonPrimaryBg              String   @default("#020617")
  colorButtonPrimaryBgHover         String   @default("#0f172a")
  colorButtonPrimaryText            String   @default("#ffffff")
  colorButtonPrimaryTextHover       String   @default("#ffffff")
  colorButtonSecondaryBg            String   @default("transparent")
  colorButtonSecondaryBgHover       String   @default("#f1f5f9")
  colorButtonSecondaryText          String   @default("#020617")
  colorButtonSecondaryTextHover     String   @default("#020617")
  colorButtonPrimaryBgDark          String   @default("#ffffff")
  colorButtonPrimaryBgHoverDark     String   @default("#f1f5f9")
  colorButtonPrimaryTextDark        String   @default("#020617")
  colorButtonPrimaryTextHoverDark   String   @default("#020617")
  colorButtonSecondaryBgDark        String   @default("transparent")
  colorButtonSecondaryBgHoverDark   String   @default("#1e293b")
  colorButtonSecondaryTextDark      String   @default("#ffffff")
  colorButtonSecondaryTextHoverDark String   @default("#ffffff")
  fontFamily                        String   @default("Inter")
  fontFamilyAr                      String   @default("Tajawal")
  isActive                          Boolean  @default(true)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  @@map("theme_settings")
}

model GeneralSettings {
  id             String   @id @default(uuid())
  currencyCode   String   @default("AED")
  currencySymbol String   @default("د.إ")
  currencyNameEn String   @default("UAE Dirham")
  currencyNameAr String   @default("درهم إماراتي")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("general_settings")
}

model ContactPageSettings {
  id             String   @id @default(uuid())
  heroImageUrl   String
  titleEn        String   @default("Get in Touch")
  titleAr        String   @default("تواصل معنا")
  descriptionEn  String
  descriptionAr  String
  phoneNumber    String
  email          String
  workingHoursEn String
  workingHoursAr String
  locationEn     String
  locationAr     String
  mapLatitude    Float?
  mapLongitude   Float?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("contact_page_settings")
}

model TermsAndConditionsPageSettings {
  id            String   @id @default(uuid())
  heroImageUrl  String
  titleEn       String   @default("Terms and Conditions")
  titleAr       String   @default("الشروط والأحكام")
  descriptionEn String
  descriptionAr String
  contentEn     String?
  contentAr     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("terms_and_conditions_page_settings")
}

model FAQPageSettings {
  id            String    @id @default(uuid())
  titleEn       String    @default("Frequently Asked Questions")
  titleAr       String    @default("الأسئلة الشائعة")
  descriptionEn String
  descriptionAr String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  faqItems      FAQItem[]

  @@map("faq_page_settings")
}

model CareersPageSettings {
  id                   String                     @id @default(uuid())
  heroImageUrl         String
  heroTitleEn          String                     @default("Careers")
  heroTitleAr          String                     @default("الوظائف")
  heroDescriptionEn    String
  heroDescriptionAr    String
  whyWorkWithUsTitleEn String?                    @default("Why Work With Us?")
  whyWorkWithUsTitleAr String?                    @default("لماذا العمل معنا؟")
  isActive             Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  jobBenefits          CareersJobBenefit[]
  jobListings          CareersJobListing[]
  whyWorkWithUsItems   CareersWhyWorkWithUsItem[]

  @@map("careers_page_settings")
}

model CareersJobBenefit {
  id            String              @id @default(uuid())
  careersPageId String
  textEn        String
  textAr        String
  order         Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  careersPage   CareersPageSettings @relation(fields: [careersPageId], references: [id], onDelete: Cascade)

  @@map("careers_job_benefits")
}

model CareersJobListing {
  id                   String              @id @default(uuid())
  careersPageId        String
  titleEn              String
  titleAr              String
  requiredExperienceEn String
  requiredExperienceAr String
  locationEn           String
  locationAr           String
  jobTypeEn            String
  jobTypeAr            String
  descriptionEn        String?
  descriptionAr        String?
  requirementsEn       String?
  requirementsAr       String?
  responsibilitiesEn   String?
  responsibilitiesAr   String?
  order                Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  careersPage          CareersPageSettings @relation(fields: [careersPageId], references: [id], onDelete: Cascade)
  applications         JobApplication[]

  @@map("careers_job_listings")
}

model JobApplication {
  id           String            @id @default(uuid())
  jobListingId String
  name         String
  email        String
  phone        String
  message      String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  jobListing   CareersJobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@map("job_applications")
}

model CareersWhyWorkWithUsItem {
  id            String              @id @default(uuid())
  careersPageId String
  titleEn       String
  titleAr       String
  descriptionEn String
  descriptionAr String
  order         Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  careersPage   CareersPageSettings @relation(fields: [careersPageId], references: [id], onDelete: Cascade)

  @@map("careers_why_work_with_us_items")
}

model FAQItem {
  id                String           @id @default(uuid())
  faqPageSettingsId String?
  questionEn        String
  questionAr        String
  answerEn          String
  answerAr          String
  order             Int              @default(0)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  faqPageSettings   FAQPageSettings? @relation(fields: [faqPageSettingsId], references: [id], onDelete: Cascade)

  @@map("faq_items")
}

model ProjectsPageSettings {
  id                String              @id @default(uuid())
  heroTitleEn       String              @default("Our Projects We Are Proud Of")
  heroTitleAr       String              @default("مشاريعنا التي نفتخر بها")
  heroDescriptionEn String?
  heroDescriptionAr String?
  heroImageUrl      String
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  heroButtons       ProjectHeroButton[]

  @@map("projects_page_settings")
}

model ProjectHeroButton {
  id                     String                @id @default(uuid())
  projectsPageSettingsId String?
  textEn                 String
  textAr                 String
  link                   String?
  order                  Int                   @default(0)
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  projectsPageSettings   ProjectsPageSettings? @relation(fields: [projectsPageSettingsId], references: [id], onDelete: Cascade)

  @@map("project_hero_buttons")
}

model RequestType {
  id              String           @id @default(uuid())
  nameEn          String
  nameAr          String
  order           Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  contactRequests ContactRequest[]

  @@map("request_types")
}

model ContactRequest {
  id            String       @id @default(uuid())
  requestTypeId String?
  name          String
  email         String
  phone         String?
  company       String?
  message       String
  status        String       @default("pending")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  requestType   RequestType? @relation(fields: [requestTypeId], references: [id])

  @@map("contact_requests")
}

model ProductsPageSettings {
  id           String   @id @default(uuid())
  heroTitleEn  String   @default("Products")
  heroTitleAr  String   @default("المنتجات")
  heroImageUrl String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("products_page_settings")
}

model ServicesPageSettings {
  id                String   @id @default(uuid())
  heroTitleEn       String   @default("Services")
  heroTitleAr       String   @default("الخدمات")
  heroDescriptionEn String?
  heroDescriptionAr String?
  heroImageUrl      String
  tickerTextEn      String?
  tickerTextAr      String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("services_page_settings")
}

model BlogsPageSettings {
  id                       String   @id @default(uuid())
  heroImageUrl             String
  titleEn                  String   @default("Blogs")
  titleAr                  String   @default("المقالات")
  descriptionEn            String
  descriptionAr            String
  heroSectionDescriptionEn String?
  heroSectionDescriptionAr String?
  gridSectionTitleEn       String?  @default("Blogs")
  gridSectionTitleAr       String?  @default("المقالات")
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("blogs_page_settings")
}

model BlogCategory {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blog[]

  @@map("blog_categories")
}

model Blog {
  id            String        @id @default(uuid())
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  contentEn     String?
  contentAr     String?
  conclusionEn  String?
  conclusionAr  String?
  authorEn      String?
  authorAr      String?
  imageUrl      String
  date          DateTime
  link          String?
  categoryId    String?
  showInHero    Boolean       @default(false)
  order         Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  category      BlogCategory? @relation(fields: [categoryId], references: [id])

  @@map("blogs")
}

model Service {
  id            String       @id @default(uuid())
  type          String       @default("card")
  count         Int
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  imageUrl      String
  order         Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tags          ServiceTag[]

  @@map("services")
}

model ServiceTag {
  id        String   @id @default(uuid())
  serviceId String
  textEn    String
  textAr    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_tags")
}

model Product {
  id                    String                 @id @default(uuid())
  titleEn               String
  titleAr               String
  descriptionEn         String?
  descriptionAr         String?
  imageUrl              String
  price                 Decimal                @db.Decimal(10, 2)
  oldPrice              Decimal?               @db.Decimal(10, 2)
  availability          Int?
  warranty              String?
  detailedDescriptionEn String?
  detailedDescriptionAr String?
  mediaUrl              String?
  mediaType             String?
  technicalDataSheetUrl String?
  catalogUrl            String?
  similarProductIds     String[]
  categoryId            String?
  productTypeId         String?
  brandLogoId           String?
  countryId             String?
  yearId                String?
  order                 Int                    @default(0)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  colors                ProductColor[]
  images                ProductImage[]
  orders                ProductOrder[]
  technicalSpecs        ProductTechnicalSpec[]
  brandLogo             BrandLogo?             @relation(fields: [brandLogoId], references: [id])
  category              Category?              @relation(fields: [categoryId], references: [id])
  country               Country?               @relation(fields: [countryId], references: [id])
  productType           ProductType?           @relation(fields: [productTypeId], references: [id])
  year                  Year?                  @relation(fields: [yearId], references: [id])

